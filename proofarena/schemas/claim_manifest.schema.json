{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProofArena Claim Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_id",
    "bounty_id",
    "source_commit",
    "scope_reference",
    "invariant",
    "reproduction",
    "evidence_sha256",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "claim_id": {
      "type": "string",
      "minLength": 4,
      "maxLength": 128
    },
    "bounty_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "scope_reference": {
      "type": "string",
      "minLength": 3,
      "maxLength": 512
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected",
        "actual"
      ],
      "properties": {
        "expected": {
          "type": "string",
          "minLength": 1
        },
        "actual": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "exit_code",
        "stdout_sha256"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "exit_code": {
          "type": "integer",
          "minimum": -255,
          "maximum": 255
        },
        "stdout_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "evidence_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "commitment_salt_hex": {
      "type": "string",
      "pattern": "^[a-f0-9]{32,128}$"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1024
      },
      "maxItems": 32
    },
    "impact_trace": {
      "type": "string",
      "maxLength": 4096
    }
  }
}
