# ProofArena configuration.
#
# Copy to `.env` and edit. This file contains no real secrets: every value is a
# local placeholder, and the wallet key is generated on first run.
#
# SECURITY: never commit `.env`. The API never needs a wallet private key —
# the signer process owns it.

# --- chain -----------------------------------------------------------------
# Only `local` is executable in this build. `near-testnet` is refused with
# E_CHAIN_UNAVAILABLE until a contract is deployed and credentials exist.
PROOFARENA_CHAIN_MODE=local
PROOFARENA_NETWORK=local-ledger
PROOFARENA_CONTRACT_ID=escrow.proofarena.local

# --- HTTP ------------------------------------------------------------------
PROOFARENA_HOST=127.0.0.1
PROOFARENA_PORT=8787
PROOFARENA_WALLET_PORT=8788

# --- auth ------------------------------------------------------------------
PROOFARENA_AUTH_DOMAIN=proofarena.local
PROOFARENA_AUTH_TTL_S=300
# Leave unset to generate and persist evidence/local/session.secret on first run.
# PROOFARENA_SESSION_SECRET=change-me-to-a-long-random-string

# --- demo identity ---------------------------------------------------------
PROOFARENA_DEMO_OWNER=owner.demo.local
# The local signer key path. Generated, git-ignored, demo-only.
# PROOFARENA_WALLET_KEY=wallet/owner.key.json

# --- storage ---------------------------------------------------------------
# PROOFARENA_DATA_DIR=evidence/local
# PROOFARENA_DB=evidence/local/proofarena.db

# --- runner limits ---------------------------------------------------------
PROOFARENA_SETTLEMENT_MODE=delayed
PROOFARENA_RUNNER_TIMEOUT_S=90
PROOFARENA_RUNNER_MAX_OUTPUT_BYTES=262144

# --- NEAR testnet (NOT CONFIGURED IN THIS BUILD) ---------------------------
# Deployment is blocked: no toolchain, no funded account, no RPC access.
# Do not invent values here. Required once credentials exist:
#   NEAR_TESTNET_ACCOUNT=<your funded testnet account, e.g. owner-<rand>.testnet>
#   NEAR_TESTNET_PRIVATE_KEY=<stored outside the repo, never committed>
#   NEAR_CONTRACT_ID=<deployed contract account>
#   NEAR_RPC_URL=https://rpc.testnet.near.org
